# cyber-offdef-gap secrets & endpoints — gitignored. Fill in the blanks.
# Load with:  set -a; source .env; set +a   (or python-dotenv in harnesses)
# Keep real values out of git. A committed template lives in .env.example.

# ─────────────────────────────────────────────────────────────────────────────
# vLLM model endpoints (the two models under test). Local to the pod; key is a
# dummy — vLLM's OpenAI server does not auth. Set BASE_URL to whichever model a
# given run targets (aligned for the control half, ablated for the treatment half).
# ─────────────────────────────────────────────────────────────────────────────
# Aligned / control  (openai/gpt-oss-120b)  — pod 7vefomehzknwgj (M0)
ALIGNED_BASE_URL=
ALIGNED_MODEL=openai/gpt-oss-120b

# Ablated / treatment (wangzhang/gpt-oss-120b-abliterated) — pod TBD (4xH200)
ABLATED_BASE_URL=
ABLATED_MODEL=wangzhang/gpt-oss-120b-abliterated

# vLLM OpenAI-compat auth placeholder (any non-empty string works)
OPENAI_API_KEY=sk-noauth

# ─────────────────────────────────────────────────────────────────────────────
# External LLM judge for ExCyTIn-Bench. Held CONSTANT across both runs.
# Pin a dated snapshot. Fill the provider you chose; leave the other blank.
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI path (recommended: paper used GPT-4o; drop-in for the SecRL/AG2 harness)
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-2024-08-06
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=

# Anthropic path (alternative judge — only if you route the grader to Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-5-20250929

# ─────────────────────────────────────────────────────────────────────────────
# Infra: RunPod (provisioning via MCP/API) + HuggingFace (model & dataset pulls)
# ─────────────────────────────────────────────────────────────────────────────
RUNPOD_API_KEY=
HF_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Spend guard — hard cap for THIS study, separate from the auditbench-uplift cap.
# ─────────────────────────────────────────────────────────────────────────────
SPEND_CAP_USD=800
